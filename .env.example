# Optional for the scaffold. Do not use production credentials.
# Providers are disabled until their respective flag is explicitly enabled.
ENABLE_DATABASE=false
MONGODB_URI=
MONGODB_DB=rentigo_development
ENABLE_CLOUDINARY=false
# Use a development product environment. Signed uploads do not need an unsigned preset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Authentication: enable only after setting up a development database and email sender.
ENABLE_AUTH=false
# Explicit prototype publishing only. Does not verify identity; active verified-email owners can publish complete listings.
ENABLE_PROTOTYPE_PUBLISHING=false
AUTH_REQUIRE_EMAIL_VERIFICATION=true
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Optional; both required to enable Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
